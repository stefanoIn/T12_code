# Per-preset uv environments and generated jobs
/runtime/experiments/*/.venv/
/runtime/experiments/*/runs/jobs/

# Generated artifacts stay beside each study and are ignored by default.
/runtime/experiments/*/runs/
# Publish only the baseline's curated metric/history JSONs.
!/runtime/experiments/sen1floods11/runs/
/runtime/experiments/sen1floods11/runs/*
!/runtime/experiments/sen1floods11/runs/results/
/runtime/experiments/sen1floods11/runs/results/*
!/runtime/experiments/sen1floods11/runs/results/*/
/runtime/experiments/sen1floods11/runs/results/*/*
!/runtime/experiments/sen1floods11/runs/results/*/common_test_results.json
!/runtime/experiments/sen1floods11/runs/results/*/training_history.json

